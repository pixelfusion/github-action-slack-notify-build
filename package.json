{
  "name": "github-action-slack-notify-build",
  "version": "1.6.0",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "ncc build index.js",
    "test": "jest"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "3.0.0",
    "@slack/web-api": "5.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.6.4",
    "@babel/preset-env": "^7.6.3",
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/git": "^9.0.0",
    "@zeit/ncc": "^0.20.5",
    "babel-jest": "^24.9.0",
    "husky": "^3.0.9",
    "jest": "^24.9.0",
    "prettier": "^1.18.2",
    "pretty-quick": "^2.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "dist"
          ]
        }
      ]
    ],
    "branches": [
      "main",
      "+([0-9])?(.{+([0-9]),x}).x",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ]
  },
  "resolutions": {
    "form-data": "2.5.6",
    "@babel/traverse": "7.23.2",
    "js-yaml": "3.15.1",
    "cross-spawn": "6.0.6",
    "@actions/core/uuid": "https://npm.aikido.io/8c3766c47d53a3ebcecd/uuid@8.3.2-aikido.5",
    "follow-redirects": "1.16.0",
    "axios": "0.33.0"
  }
}
